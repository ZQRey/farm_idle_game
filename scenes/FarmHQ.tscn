[node name="BankruptcyDialog" type="ConfirmationDialog" parent="."]
title = "Подтверждение банкротства"
initial_position = 2
size = Vector2i(450, 160)
dialog_text = "Вы действительно хотите объявить ферму банкротом?

Все долги по субсидиям и кредитам будут полностью списаны!
Прогресс, апгрейды и культуры будут сброшены к началу игры (100 🪙)."
ok_button_text = "Да, объявить банкротство"
cancel_button_text = "Отмена"

